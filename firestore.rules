rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- Validation Blueprints ---
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'preferredLanguage', 'preferredTheme', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'preferredLanguage', 'preferredTheme', 'createdAt', 'updatedAt'])
        && data.uid is string
        && data.uid == userId
        && data.uid == request.auth.uid
        && isValidId(data.uid)
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 80
        && (!('email' in data) || (data.email is string && data.email.size() <= 160))
        && data.preferredLanguage in ['km', 'en']
        && data.preferredTheme in ['light', 'dark']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWhiteboardProject(data) {
      return data.keys().hasAll(['ownerId', 'title', 'pageCount', 'backgroundStyle', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'title', 'pageCount', 'backgroundStyle', 'thumbnailDataUrl', 'createdAt', 'updatedAt'])
        && data.ownerId is string
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 120
        && data.pageCount is int
        && data.pageCount >= 1
        && data.pageCount <= 20
        && data.backgroundStyle in ['plain', 'dots', 'grid', 'ruled']
        && (!('thumbnailDataUrl' in data) || (data.thumbnailDataUrl is string && data.thumbnailDataUrl.size() <= 120000))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWhiteboardPage(data, boardId) {
      return data.keys().hasAll(['ownerId', 'boardId', 'pageIndex', 'title', 'items', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'boardId', 'pageIndex', 'title', 'items', 'updatedAt'])
        && data.ownerId is string
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.boardId is string
        && data.boardId == boardId
        && isValidId(data.boardId)
        && data.pageIndex is int
        && data.pageIndex >= 0
        && data.pageIndex < 20
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 80
        && data.items is list
        && data.items.size() <= 500
        && (data.items.size() == 0 || data.items[0] is map)
        && data.updatedAt is timestamp;
    }

    function isValidProjectHistory(data, boardId) {
      return data.keys().hasAll(['ownerId', 'boardId', 'summary', 'pageCount', 'itemCount', 'snapshotPages', 'createdAt'])
        && data.keys().hasOnly(['ownerId', 'boardId', 'summary', 'pageCount', 'itemCount', 'snapshotPages', 'createdAt'])
        && data.ownerId is string
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.boardId is string
        && data.boardId == boardId
        && isValidId(data.boardId)
        && data.summary is string
        && data.summary.size() >= 1
        && data.summary.size() <= 160
        && data.pageCount is int
        && data.pageCount >= 1
        && data.pageCount <= 20
        && data.itemCount is int
        && data.itemCount >= 0
        && data.itemCount <= 10000
        && data.snapshotPages is list
        && data.snapshotPages.size() >= 1
        && data.snapshotPages.size() <= 20
        && data.snapshotPages[0] is map
        && data.createdAt is timestamp;
    }

    function isBoardOwner(boardId) {
      return exists(/databases/$(database)/documents/boards/$(boardId))
        && get(/databases/$(database)/documents/boards/$(boardId)).data.ownerId == request.auth.uid;
    }

    // --- Collection: /users/{userId} (Strict PII Isolation) ---
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false;
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'preferredLanguage', 'preferredTheme', 'updatedAt']);
      allow delete: if isVerifiedUser() && isValidId(userId) && request.auth.uid == userId;
    }

    // --- Collection: /boards/{boardId} ---
    match /boards/{boardId} {
      allow get: if isSignedIn() && isValidId(boardId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isVerifiedUser()
        && isValidId(boardId)
        && isValidWhiteboardProject(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(boardId)
        && isValidWhiteboardProject(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'pageCount', 'backgroundStyle', 'thumbnailDataUrl', 'updatedAt'])
        );
      allow delete: if isVerifiedUser() && isValidId(boardId) && existing().ownerId == request.auth.uid;

      // --- Subcollection: /boards/{boardId}/pages/{pageId} ---
      match /pages/{pageId} {
        allow get: if isSignedIn() && isValidId(boardId) && isValidId(pageId) && existing().ownerId == request.auth.uid && isBoardOwner(boardId);
        allow list: if isSignedIn() && isValidId(boardId) && resource.data.ownerId == request.auth.uid;
        allow create: if isVerifiedUser()
          && isValidId(boardId)
          && isValidId(pageId)
          && isValidWhiteboardPage(incoming(), boardId)
          && incoming().updatedAt == request.time
          && isBoardOwner(boardId);
        allow update: if isVerifiedUser()
          && isValidId(boardId)
          && isValidId(pageId)
          && isValidWhiteboardPage(incoming(), boardId)
          && existing().ownerId == request.auth.uid
          && incoming().ownerId == existing().ownerId
          && incoming().boardId == existing().boardId
          && incoming().updatedAt == request.time
          && isBoardOwner(boardId)
          && incoming().diff(existing()).affectedKeys().hasOnly(['pageIndex', 'title', 'items', 'updatedAt']);
        allow delete: if isVerifiedUser() && isValidId(boardId) && isValidId(pageId) && existing().ownerId == request.auth.uid && isBoardOwner(boardId);
      }

      // --- Subcollection: /boards/{boardId}/history/{historyId} ---
      match /history/{historyId} {
        allow get: if isSignedIn() && isValidId(boardId) && isValidId(historyId) && existing().ownerId == request.auth.uid && isBoardOwner(boardId);
        allow list: if isSignedIn() && isValidId(boardId) && resource.data.ownerId == request.auth.uid;
        allow create: if isVerifiedUser()
          && isValidId(boardId)
          && isValidId(historyId)
          && isValidProjectHistory(incoming(), boardId)
          && incoming().createdAt == request.time
          && isBoardOwner(boardId);
        allow update: if false;
        allow delete: if isVerifiedUser() && isValidId(boardId) && isValidId(historyId) && existing().ownerId == request.auth.uid && isBoardOwner(boardId);
      }
    }
  }
}
